node_modules/
out/
dist/
# Anchored. An unanchored `release/` matches a directory of that name at ANY
# depth, which silently swallowed docs/release/ - the step-4 runbook and the
# harvested release notes were ignored and would never have been committed.
/release/
*.log
.DS_Store
.vite/
.env
.env.*
.gstack/

# git-bash crash dumps
*.stackdump

# agent plugin working state (analyses, spike notes), like .gstack/ above.
# 4.7M of session scratch. Anything durable from it belongs in CHANGELOG.md or
# NOTES.md, which is where the bake-off removal's reasoning ended up.
.superpowers/

# Vendored design references. Kept for local use only: both were moved in from
# user scope and neither records a licence, so their provenance cannot be
# established -- and SignPath Foundation requires that every component's licence
# be nameable. Stripped from history 2026-09-02; do not re-add them.
.claude/skills/apple-design/
.claude/skills/animation-vocabulary/

# generated by scripts/ci-builder-config.mjs during the CI release build
/electron-builder.ci.json
/release-ci/
